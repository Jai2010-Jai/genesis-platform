# Copy to .env and fill in. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=your-gemini-api-key-here

# "auto" picks the best available model from your account's model list.
# Or set an explicit model id, e.g. gemini-flash-latest / gemini-pro-latest.
GEMINI_MODEL=auto

# AI provider for conversation and code generation: "api" (Gemini API, needs GEMINI_API_KEY; recommended) or
# "antigravity" (legacy: the Antigravity desktop app's agentapi bridge; only works when started from a terminal
# inside Antigravity). The website builder requires "api". Genesis never switches provider on its own.
# GENESIS_ANTIGRAVITY_MODEL: app (the model picked in Antigravity) | flash_lite | flash | pro
GENESIS_AI_BACKEND=api
GENESIS_ANTIGRAVITY_MODEL=app

# Toolchain (auto-detected if empty).
JAVA_HOME=
ANDROID_HOME=

# Limits
GENESIS_BUILD_TIMEOUT_SECONDS=900
GENESIS_MAX_REPAIR_ATTEMPTS=2
GENESIS_MAX_CONCURRENT_BUILDS=1
GENESIS_MAX_QUEUED_BUILDS=5

# Dashboard bind address. Keep 127.0.0.1: there is no authentication.
GENESIS_HOST=127.0.0.1
GENESIS_PORT=8765

# ---------------- SMS / WhatsApp via Twilio (see docs/SMS.md) ----------------
# twilio (default) | log (write replies to data/sms-outbox.log, send nothing) | off
GENESIS_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender, e.g. +14155550123. Or leave empty and set TWILIO_MESSAGING_SERVICE_SID.
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp sender (recommended for India: SMS to India is one-way only). Sandbox: +14155238886.
# Replies always go back on the channel the user wrote in (WhatsApp, SMS or the web chat).
TWILIO_WHATSAPP_NUMBER=
# Legacy: TWILIO_CHANNEL=whatsapp treats TWILIO_PHONE_NUMBER as the WhatsApp sender.
TWILIO_CHANNEL=sms
# Optional Twilio region/edge for API calls, e.g. TWILIO_REGION=ie1 TWILIO_EDGE=dublin
TWILIO_REGION=
TWILIO_EDGE=
# Public https origin that forwards to this machine (tunnel/proxy), e.g. https://genesis.example.com
# Used to validate X-Twilio-Signature and to build download links.
PUBLIC_BASE_URL=
# Who may use Genesis by text: closed (owners only) | link (owners + LINK <code>) | open (anyone, as guests)
GENESIS_SMS_SIGNUP=link
# Your own number(s), comma-separated E.164. These are trusted without a link code.
GENESIS_SMS_OWNER_NUMBERS=
# Used only for numbers given without a country code (Twilio always sends E.164).
GENESIS_SMS_DEFAULT_COUNTRY_CODE=+91
# embedded: worker runs inside `genesis serve`; external: run `python -m genesis sms-worker` separately
GENESIS_SMS_WORKER=embedded
GENESIS_SMS_DAILY_BUILDS=20
GENESIS_SMS_GUEST_DAILY_BUILDS=3
GENESIS_SMS_INBOUND_PER_HOUR=30
GENESIS_SMS_MAX_QUEUED=20
GENESIS_SMS_JOB_MAX_ATTEMPTS=3
# all | major | off, and the minimum gap between progress texts
GENESIS_SMS_PROGRESS=major
GENESIS_SMS_PROGRESS_MIN_INTERVAL_SECONDS=60
GENESIS_SMS_LINK_TTL_HOURS=72

# ---------------- Website builder (see docs/WEBSITES.md) ----------------
# Path to an unmodified checkout of https://github.com/adityapokuri229/weave (its src/portfolio/ generator is run
# through genesis/web/bridge.mjs). Empty = Genesis says websites are unavailable and builds only Android apps.
GENESIS_WEBSITE_ENGINE_DIR=
# on | off
GENESIS_WEBSITE_BUILDER=on
# Node.js 20+ (auto-detected from PATH if empty)
GENESIS_NODE_BIN=
# Design options per new website, 1-3 (each extra option is another large Gemini call)
GENESIS_WEBSITE_VARIANTS=1
GENESIS_WEBSITE_TIMEOUT_SECONDS=600
# Publishing: off (default: private previews only) | netlify. Even when on, only the owner can publish, and only
# after replying PUBLISH to Genesis's confirmation. There is no anonymous deploy fallback.
GENESIS_WEBSITE_DEPLOY=off
# Netlify personal access token (https://app.netlify.com/user/applications#personal-access-tokens). Server-side only.
NETLIFY_AUTH_TOKEN=
